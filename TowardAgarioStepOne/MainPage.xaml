<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TowardAgarioStepOne.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <HorizontalStackLayout 
                Padding="30,0"
                Spacing="25">
                    <Label
                        Text="Center: "
                        x:Name="CircleCenterLbl"/>

                    <Label
                        Text="Direction: "
                        x:Name="DirectionLbl"/>
            </HorizontalStackLayout>

            <GraphicsView 
                x:Name="PlaySurface"
                VerticalOptions="Center"
                BackgroundColor="Blue"
                HeightRequest="800"
                WidthRequest="800" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
